---
// tipar los valores de los datos
interface Props {
  title: string;
  company?: string | { name: string; url?: string };
  description: string;
  link?: string; // lleva ? porque el link puede ser undefined
  date: string;
}
// recuperar de astro props estos valores
const { title, company, description, link, date } = Astro.props;

// Aquí normalizamos el nombre de la empresa. Si company es un string, lo usamos directamente. Si es un objeto, usamos su propiedad "name". El ?. evita errores si company es undefined
const companyName = typeof company === "string" ? company : company?.name;

// Aquí sacamos la URL de la empresa (si existe)  Si company es string, no hay URL → devolvemos undefined. Si es objeto, intentamos acceder a "url". Si no existe, queda undefined sin romper nada
const companyUrl = typeof company === "string" ? undefined : company?.url;
---

<div
  class="absolute w-3 h-3 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-[#8b63f7] bg-[#8b63f7]"
>
</div>
<h3 class="text-lg font-semibold text-[#8b63f7] mt-3">
  {title}
  {
    companyName && (
      <>
       {/* Si existe companyName, entra aquí  */}
        <span class="dark:text-white text-gray-900"> - </span>

        {companyUrl ? (
          // Si existe URL de la empresa → se muestra como enlace
          <a
            href={companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#f59e0b] text-sm hover:underline"
          >
            {companyName}
          </a>
        ) : (
          // Si NO hay URL → se muestra solo texto
          <span class="text-[#f59e0b] text-sm">{companyName}</span>
        )}
      </>
    )
  }
</h3>
<time class="mb-1 text-sm font-normal leading-none text-gray-400">{date}</time>
<div
  class="mb-4 text-base font-normal text-gray-700 dark:text-gray-300 text-pretty"  set:html={description}
>
</div>

<!-- renderizado condicional (por si no hay enlace) -->
{
  link && (
    <a
      href={link}
      class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
    >
      Saber más...{" "}
      <svg
        class="w-3 h-3 ms-2 rtl:rotate-180"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"
        />
      </svg>
    </a>
  )
}
