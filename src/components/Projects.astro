---
import type tailwindcss from "@tailwindcss/vite";
import WordPressIcon from "@/components/icons/WordPress.astro";
import ElementorIcon from "@/components/icons/Elementor.astro";
import CakePHPIcon from "@/components/icons/CakePHP.astro";
import BootstrapIcon from "@/components/icons/Bootstrap.astro";
import JavaScriptIcon from "@/components/icons/JavaScript.astro";
import MoodleIcon from "@/components/icons/Moodle.astro";
import Link from "@/components/icons/Link.astro";
import LinkButton from "@/components/LinkButton.astro";
import GitHub from "@/components/icons/GitHub.astro";
import HTMLIcon from "@/components/icons/HTML.astro";
import CSSIcon from "@/components/icons/CSS.astro";
import AstroIcon from "@/components/icons/Astro.astro";
import TailwindCSSIcon from "@/components/icons/TailwindCSS.astro";

const TAGS = {
  HTML: {
    name: "HTML",
    class: "bg-blue-100 text-[#21759B]",
    icon: HTMLIcon
  },
  CSS: {
    name: "CSS",
    class: "bg-blue-100 text-[#21759B]",
    icon: CSSIcon
  },
  WORDPRESS: {
    name: "WordPress",
    class: "bg-blue-100 text-[#21759B]",
    icon: WordPressIcon
  },
  ELEMENTOR: {
    name: "Elementor",
    class: "bg-pink-200 text-pink-900",
    icon: ElementorIcon
  },
  CAKEPHP: {
    name: "CakePHP",
    class: "bg-rose-200 text-rose-700",
    icon: CakePHPIcon
  },
  BOOTSTRAP: {
    name: "Bootstrap",
    class: "bg-purple-100 text-purple-700",
    icon: BootstrapIcon
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-100 text-yellow-800",
    icon: JavaScriptIcon
  },
  MOODLE: {
    name: "Moodle",
    class: "bg-orange-100 text-orange-700",
    icon: MoodleIcon
  },
  ASTRO: {
    name: "Astro",
    class: "bg-orange-100 text-orange-700",
    icon: AstroIcon
  },
  TAILWINDCSS: {
    name: "Tailwind CSS",
    class: "bg-orange-100 text-orange-700",
    icon: TailwindCSSIcon
  },
};

const PROJECTS = [
  {
    title: "Portfolio personal",
    description: "Web personal destinada a presentar mi perfil profesional, desarrollada como proyecto práctico con tecnologías como Astro, HTML, CSS y Tailwind CSS. Diseño moderno, adaptable y fácil de mantener.",
    link: "https://diegopefer.github.io/portfolio/",
    github:"https://github.com/diegopefer",
    image: "projects/portfolio-diego-pena.webp",
    alt: "Portfolio web personal de Diego Pena",
    tags: [TAGS.ASTRO,TAGS.HTML, TAGS.CSS,TAGS.TAILWINDCSS,TAGS.JAVASCRIPT],
  },
  {
    title: "Panda4Events - Web corporativa para gestión de eventos deportivos",
    description: "Web informativa desarrollada en WordPress con Elementor, diseñada para reforzar la imagen corporativa y facilitar la difusión de campus deportivos.",
    link: "https://panda4events.com",
    image: "projects/panda4events-project.webp",
    alt: "Aplicación Panda4Events para gestión de eventos deportivos",
    tags: [TAGS.WORDPRESS, TAGS.ELEMENTOR],
  },
  {
    title: "Cathedra Formación - Web académica informativa",
    description: "Web destinada a mostrar la oferta formativa y novedades de la academia. Reconstruida con CakePHP, Bootstrap y JavaScript y diseñada para facilitar la gestión de contenidos.",
    link: "http://cathedraformacion.es/",
    image: "projects/cathedraformacion-project.webp",
    alt: "Sitio web de la academia Cathedra Formación",
    tags: [TAGS.CAKEPHP, TAGS.BOOTSTRAP, TAGS.JAVASCRIPT, TAGS.MOODLE],
  },
  {
    title: "Herramienta web para la divulgación de DAEIRA",
    description: "Aplicación web desarrollada como TFG para divulgar las investigaciones del grupo DAEIRA de la UVigo, centradas en análisis y reconocimiento de imágenes. Implementada desde cero con CakePHP, Bootstrap y JavaScript, con diseño responsive y estructura orientada a la difusión de contenido científico.",
    link: "http://lia.ei.uvigo.es/daeira/",
    image: "projects/daeira-project.webp",
    alt: "Web del grupo DAEIRA para divulgar investigaciones en reconocimiento de imágenes",
    tags: [TAGS.CAKEPHP, TAGS.BOOTSTRAP, TAGS.JAVASCRIPT],
  },

];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image,alt, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 md:space-x-8 md:space-y-0 group md:flex-row">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip  rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img alt={alt} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />

          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
           <h3 class="text-2xl font-bold text-gray-700 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-col flex-wrap mt-2">
            <ul class="flex flex-wrap mb-2 gap-2">
              {tags.map((tag) =>(
                <li>
                  <span class={`flex gap-2 rounded-full text-xs py-1 px-2 ${tag.class}`}>
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-300">{description}</div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-6" />
                </LinkButton>
              )}
            </footer>
          </div>
        </div>

      </article>
    ))
  }
</div>
