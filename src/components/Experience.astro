---
import ExperienceItem from "../components/ExperienceItem.astro";

const EXPERIENCE = [
    {
        date: "Febrero 2025 – Actualmente...",
        title: "Desarrollador Web WordPress (Freelance)",
        company: "Panda Events 4 Sports",
        description: "Diseñé e implementé la web con Elementor, asegurando coherencia visual, estructura clara y funcionalidades adaptadas a los objetivos del cliente. Construí una solución escalable y fácil de gestionar, mejorando la experiencia de usuario y facilitando futuras integraciones. Actualmente realizo mantenimiento continuo: actualizaciones de plugins, gestión de contenidos y resolución de incidencias, garantizando rendimiento y estabilidad del sitio." //(en cada experiencia añadir logros)
    },
    {
        date: "Enero 2024 – Enero 2025",
        title: "Consultor eCommerce y Marketing Digital (Freelance)",
        description: "Gestioné proyectos propios de eCommerce con modelo de dropshipping orgánico, seleccionando productos con alto potencial viral y creando contenido optimizado en TikTok e Instagram, generando tráfico orgánico y conversión a ventas. Configuré y administré tiendas Shopify, gestioné pedidos y realicé atención al cliente, garantizando una eficiencia operativa y satisfacción del cliente."
    },
    {
        date: "Junio 2021 – Diciembre 2023",
        title: "Analista de automatización de procesos N2 Operación Comercial",
        company: "Viewnext (Proyecto Inditex: Zara.com)",
        description: "Desarrollé automatizaciones en Python y Groovy que redujeron tareas manuales y mejoraron la eficiencia de varios equipos. Resolví incidencias técnicas mediante trazas, SQL, APIs y scripts personalizados, y coordiné soluciones con otros equipos para asegurar la continuidad del servicio. Además, propuse mejoras y documenté procedimientos, fomentando la reutilización de herramientas y el conocimiento compartido."
    },
    {
        date: "Enero 2021 – Junio 2021",
        title: "Operador N1 eCommerce",
        company: "Viewnext (Proyecto Inditex/Zara.com)",
        description: "Analicé y resolví incidencias técnicas, escalando los casos complejos cuando fue necesario y asegurando la disponibilidad de la plataforma eCommerce."
    },
    {
        date: "Marzo 2019 – Octubre 2020",
        title: "Desarrollador Web (Freelance)",
        company: "Cathedra Formación",
        description: "Reconstruí la web corporativa desde cero utilizando CakePHP y Bootstrap, mejorando la gestión de contenidos y la experiencia de usuario. También apoyé la reorganización de cursos en la plataforma Moodle, facilitando una administración más eficiente para el cliente."
    }
    
]
---
<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3"> 
    {
        EXPERIENCE.map(experience => (
            <li class="mb-10 ms-4">
                <ExperienceItem {...experience}/>
            </li>
        ))
    }       
</ol>

