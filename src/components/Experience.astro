---
import ExperienceItem from "../components/ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Febrero 2024 – Actualmente...",
    title: "Desarrollador Web WordPress (Freelance)",
    company: {
      name: "Panda Events 4 Sports",
      url: "https://panda4events.com/",
    },
    description:
      "Diseñé e implementé la web en WordPress con Elementor, asegurando una estructura clara, coherencia visual y un diseño responsive alineado con los objetivos del cliente. El proyecto permitió al cliente contar con una web funcional y profesional para reforzar su presencia online y facilitar la gestión de reservas y contenidos. <br><br>Actualmente me encargo del mantenimiento del sitio, gestionando contenidos, actualizaciones y resolución de incidencias para garantizar su correcto funcionamiento.",
  },
  {
    date: "Febrero 2024 – Enero 2025",
    title: "Especialista en eCommerce y Marketing de Contenidos (Freelance)",
    description:
      "Gestioné proyectos propios de eCommerce basados en dropshipping orgánico, analizando tendencias y seleccionando productos con alto potencial de viralización. Creé contenido optimizado en TikTok e Instagram para generar tráfico orgánico y convertir visitas en ventas.<br><br>Configuré y administré tiendas Shopify, gestionando pedidos y atención al cliente, asegurando una operativa eficiente y una experiencia de compra satisfactoria.",
  },
  {
    date: "Junio 2021 – Enero 2024",
    title: "Analista de Automatización de Procesos N2 Operación Comercial",
    company: "Viewnext (Proyecto Inditex - Zara.com)",
    description:
      "Desarrollé automatizaciones en Python y Groovy que redujeron tareas manuales y mejoraron la eficiencia operativa de la plataforma. Analicé y resolví incidencias técnicas mediante logs, SQL (DB2), APIs y scripts personalizados, y coordiné soluciones automatizadas con otros equipos para asegurar la continuidad del servicio. <br><br>Documenté procesos y propuse mejoras orientadas al uso compartido, facilitando la colaboración del equipo.",
  },
  {
    date: "Enero 2021 – Junio 2021",
    title: "Operador N1 eCommerce",
    company: "Viewnext (Proyecto Inditex - Zara.com)",
    description:
      "Analicé y resolví incidencias técnicas, escalando casos complejos de manera eficiente para garantizar la disponibilidad y continuidad operativa, siguiendo procedimientos internos.",
  },
  {
    date: "Octubre 2019 – Octubre 2020",
    title: "Desarrollador Web (Freelance)",
    company: {
      name: "Academia Cathedra Formación",
      url: "http://www.cathedraformacion.es/",
    },
    description:
      "Reconstruí la web corporativa desde cero utilizando CakePHP y Bootstrap, optimizando la gestión de contenidos y la experiencia de usuario. Ayudé a la reorganización de cursos en Moodle, facilitando una administración más eficiente para el cliente.",
  },
];
---

<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
